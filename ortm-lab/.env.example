# Local-only ORTM lab settings. Run `bin/ortm-lab init` to create .env.

# Keep the Compose project name stable because monitor/netem use the publisher
# container name. This makes the lab independent from the checkout directory.
COMPOSE_PROJECT_NAME=tunnel

# Unique label stored in publisher metrics. It does not need to be a hostname.
DEVICE_ID=ortm-lab-host

# Browser-visible origin. For a viewer on this machine, keep localhost. For a
# remote viewer, use an HTTPS origin reachable by that device, for example a
# Tailscale Serve URL.
LAB_PUBLIC_ORIGIN=http://127.0.0.1:9001

# Optional explicit WHEP URL. Empty means LAB_PUBLIC_ORIGIN/fish_front/whep.
LAB_WHEP_URL=

# Generated by `bin/ortm-lab init`. Do not commit the resulting .env file.
VIEWER_CONTROL_TOKEN=change-me
VIEWER_CONTROL_PEER_ID=

PORT=9001
MONITOR_PORT=9010
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_ENABLED=false
PROMETHEUS_RETENTION=2d

MEDIAMTX_USERNAME=metrics
MEDIAMTX_PASSWORD=metrics123
MONITOR_STREAMS=fish_front
PUBLISHER_CONTAINERS=tunnel-fish_front_whip-1

# Set to 0 on a minimal machine when Prometheus/Grafana are not required.
LAB_ENABLE_OBSERVABILITY=1

# First base-image build can take a long time. Override this only when using a
# prebuilt compatible image.
WHIP_PUBLISHER_BASE_IMAGE=tunnel-whip-publisher-base:ubuntu24.04-gst-rs-0.14.1

# Runtime behavior shared by all scenarios unless overridden in a scenario.
VIEWER_WAIT_SECONDS=120
PUBLISHER_WAIT_SECONDS=45
RESULT_ROOT=ortm-lab/results
FAIL_ON_QUALITY_GATE=1
