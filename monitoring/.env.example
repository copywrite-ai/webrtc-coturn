# Host ports. Change these when another monitoring stack already uses them.
MONITOR_HOST_PORT=9010
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# MediaMTX running on the Docker host.
MEDIAMTX_API_ORIGIN=http://host.docker.internal:9997
MEDIAMTX_METRICS_ORIGIN=http://host.docker.internal:9998
MEDIAMTX_USERNAME=metrics
MEDIAMTX_PASSWORD=change-me

# Publisher and browser metric inputs.
PUBLISHER_CONTAINERS=tunnel-fish_front_whip-1
MONITOR_STREAMS=fish_front
CLIENT_LOG_HOST_PATH=../logs
DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock

MONITOR_POLL_MS=2000
MONITOR_HISTORY_LIMIT=900
PROMETHEUS_RETENTION=2d

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ANONYMOUS_ENABLED=false
